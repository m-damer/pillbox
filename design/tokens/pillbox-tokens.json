  "highContrastRules": [
    "Black text on white",
    "2dp borders on all cards (color.border)",
    "No tinted dose blocks",
    "Darker primary"
  ],
  "type": {
    "fontFamily": {
      "latin": "Inter",
      "arabic": "Baloo Bhaijaan 2"
    },
    "weight": {
      "regular": 400,
      "semibold": 600
    },
    "scale": {
      "caption": 13,
      "secondary": 14,
      "body": 15,
      "bodyLarge": 16,
      "input": 17,
      "titleSmall": 20,
      "title": 22,
      "headline": 24,
      "displayTime": 36,
      "displayCount": 40,
      "hero": 48
    },
    "lineHeight": 1.4,
    "minimum": 13,
    "note": "Scale with system font size up to 200%. Heights are minimums, never fixed."
  },
  "radius": {
    "chip": 10,
    "small": 14,
    "input": 18,
    "card": 22,
    "button": "full",
    "sheet": 28,
    "avatar": "full",
    "pill": 24
  },
  "space": {
    "2": 2,
    "4": 4,
    "6": 6,
    "8": 8,
    "10": 10,
    "12": 12,
    "16": 16,
    "20": 20
  },
  "layout": {
    "screenPaddingH": 16,
    "screenPaddingTop": 12,
    "screenPaddingBottom": 20,
    "cardGap": 12,
    "listRowMinHeight": 56,
    "settingsRowMinHeight": 64
  },
  "size": {
    "touchTargetMin": 48,
    "primaryButtonHeight": 52,
    "primaryButtonHeightLarge": 56,
    "bottomNavHeight": 80,
    "fab": 60,
    "switchWidth": 52,
    "switchHeight": 32,
    "icon": 24,
    "iconSmall": 18,
    "logo": 128,
    "logoSmall": 72,
    "starSize": 40,
    "previewMaxHeight": 460
  },
  "rules": {
    "contrastMin": "4.5:1 for text",
    "colorNeverOnlySignal": true,
    "arabicTime": "digits then ص or م, with ص and م on the left (use a right-to-left isolate)"
  },
